{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the user"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor", "visitor"],
          "description": "Access control role of the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "A blog post article written by creators or editors",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the blog post"
        },
        "title": {
          "type": "string",
          "description": "Title of the blog post"
        },
        "content": {
          "type": "string",
          "description": "Body block content of the post in markdown or text"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the user who authored this post"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"],
          "description": "Current workflow status of the post"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when last updated"
        }
      },
      "required": ["id", "title", "content", "authorId", "authorName", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile storage"
    },
    "/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/BlogPost"
      },
      "description": "Blog articles storage"
    }
  }
}
