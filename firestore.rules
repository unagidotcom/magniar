rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default catch-all: Deny all read/write
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // Primatives & Global Security Helpers
    // ----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Check if the current user has the 'admin' role in /users/{uid}
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if current user has 'editor' or 'admin' role
    function isContentCreator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor');
    }

    // ----------------------------------------------------
    // Entities Rules
    // ----------------------------------------------------

    // 1. Users Collection
    match /users/{userId} {
      // Validate structure for Create & Update
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
          data.keys().size() == 5 &&
          data.uid == request.auth.uid &&
          data.uid is string &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
          data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
          data.role is string && (data.role == 'visitor' || data.role == 'editor' || data.role == 'admin') &&
          data.createdAt == request.time;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      // Allow creation of a user profile upon registration
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && incoming().role == 'visitor';
      
      // Only admin or the exact user can edit their profile
      allow update: if isSignedIn() && isValidId(userId) && (
        (isOwner(userId) && incoming().role == existing().role && incoming().createdAt == existing().createdAt && isValidUser(incoming())) ||
        (isAdmin() && isValidUser(incoming()))
      );
      
      allow delete: if isAdmin();
    }

    // 2. Posts Collection (Blog Posts)
    match /posts/{postId} {
      function isValidPost(data) {
        return data.keys().hasAll(['id', 'title', 'content', 'authorId', 'authorName', 'status', 'createdAt', 'updatedAt']) &&
          data.keys().size() == 8 &&
          data.id == postId &&
          data.id is string &&
          data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
          data.content is string && data.content.size() <= 100000 &&
          data.authorId is string && data.authorId == request.auth.uid &&
          data.authorName is string && data.authorName.size() <= 100 &&
          data.status is string && (data.status == 'draft' || data.status == 'published') &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      // Public reads for published posts, authenticated reads for draft authors/admins
      allow get: if existing().status == 'published' || (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()));
      // Secure safe listing
      allow list: if (resource.data.status == 'published') || (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));

      // Content creator rules
      allow create: if isSignedIn() && isValidId(postId) && isContentCreator() && isValidPost(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() && isValidId(postId) && (
        // Author edits their own post
        (existing().authorId == request.auth.uid && isValidPost(incoming()) && incoming().authorId == existing().authorId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time) ||
        // Admin overrides
        (isAdmin() && isValidPost(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time)
      );

      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }
  }
}
